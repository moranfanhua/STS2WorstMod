<Project Sdk="Godot.NET.Sdk/4.5.1">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ReZeroSpire</RootNamespace>
    <AssemblyName>ReZeroSpire</AssemblyName>
    <DllDir>ReZeroSpireCode\dll</DllDir>
    <GodotProjectDir>$(MSBuildThisFileDirectory)</GodotProjectDir>
    <GodotExe Condition="'$(GodotExe)' == ''">C:\Users\MoXia\Downloads\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64.exe</GodotExe>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(DllDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(DllDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="STS2.RitsuLib" Version="0.4.*" />
  </ItemGroup>

  <Target Name="ExportPck" AfterTargets="Build">
    <PropertyGroup>
      <PckPath>$([System.IO.Path]::Combine($(OutputPath), $(AssemblyName))).pck</PckPath>
    </PropertyGroup>
    <Message Text="Exporting PCK from $(GodotProjectDir) to $(PckPath)..." Importance="high" />
    <Exec
      Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(GodotProjectDir)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(PckPath)&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
      ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
